---
import 'katex/dist/katex.min.css';
import Layout from './Layout.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	ogType?: 'website' | 'article';
	canonical?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
}

const { title, description, image, ogType, canonical, ogImageWidth, ogImageHeight, ogImageAlt } = Astro.props;
---

<Layout title={title} description={description} image={image} ogType={ogType} canonical={canonical} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} ogImageAlt={ogImageAlt}>
  <main>
    <div class="article-header border-b border-hairline-soft bg-canvas py-5">
      <div class="container mx-auto px-6">
        <a href="/#articulos" data-back-link class="mb-2 inline-flex min-h-11 items-center gap-1 font-mono text-sm text-accent transition-colors hover:text-accent-hover">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          Volver atrás
        </a>
      </div>
    </div>

    <!-- `project-content` is kept on purpose: it carries the article typography,
         code-block styles and the copy-button hook implemented in Layout.astro. -->
    <div class="article-content project-content bg-canvas py-12">
      <div class="container mx-auto px-6 max-w-4xl">
        <slot />
      </div>
    </div>
  </main>
</Layout>

<style>
  @media (max-width: 639px) {
    .article-content :global(table) {
      display: block;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      box-sizing: border-box;
      overscroll-behavior-x: contain;
    }
    .article-content :global(table th),
    .article-content :global(table td) {
      white-space: nowrap;
    }
  }
</style>
