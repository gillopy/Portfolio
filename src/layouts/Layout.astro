---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import siteConfig from '../data/siteConfig.json';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
	ogType?: 'website' | 'article';
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
}

const {
	title = siteConfig.title,
	description = siteConfig.description,
	canonical: canonicalProp,
	image,
	ogType = 'website',
	noindex = false,
	jsonLd,
	ogImageWidth,
	ogImageHeight,
	ogImageAlt,
} = Astro.props;

const site = Astro.site;
const canonicalURL = !noindex ? (canonicalProp ?? (site ? new URL(Astro.url.pathname, site).href : undefined)) : undefined;
const ogImageURL = site ? new URL(image ?? siteConfig.ogImage, site).href : undefined;
// WhatsApp/FB require explicit dimensions + type; default OG is always 1200x630 JPEG
const isDefaultOg = !image || image === siteConfig.ogImage;
const resolvedOgWidth = ogImageWidth ?? (isDefaultOg ? 1200 : undefined);
const resolvedOgHeight = ogImageHeight ?? (isDefaultOg ? 630 : undefined);
const resolvedOgAlt = ogImageAlt ?? (isDefaultOg ? 'Portfolio de Guillermo Cabrera — Data Scientist' : undefined);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		{siteConfig.author && <meta name="author" content={siteConfig.author} />}
		{noindex && <meta name="robots" content="noindex" />}
		{canonicalURL && <link rel="canonical" href={canonicalURL} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		{site && <meta property="og:site_name" content={siteConfig.title} />}
		<meta property="og:locale" content={siteConfig.locale ?? 'es_PY'} />
		{canonicalURL && <meta property="og:url" content={canonicalURL} />}
		{ogImageURL && <meta property="og:image" content={ogImageURL} />}
		{ogImageURL && <meta property="og:image:secure_url" content={ogImageURL} />}
		{ogImageURL && <meta property="og:image:type" content="image/jpeg" />}
		{ogImageURL && resolvedOgWidth && <meta property="og:image:width" content={String(resolvedOgWidth)} />}
		{ogImageURL && resolvedOgHeight && <meta property="og:image:height" content={String(resolvedOgHeight)} />}
		{ogImageURL && resolvedOgAlt && <meta property="og:image:alt" content={resolvedOgAlt} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
		<meta name="twitter:site" content={siteConfig.twitterHandle} />
		<meta name="twitter:creator" content={siteConfig.twitterHandle} />
		{site && <link rel="sitemap" href="/sitemap-index.xml" />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#090909" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<title>{title}</title>
		{jsonLd && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		)}
		<ClientRouter />
		<script is:inline>
			(() => {
				try {
					const t = localStorage.getItem('theme');
					document.documentElement.dataset.theme = (t === 'light' || t === 'dark') ? t : 'dark';
				} catch {
					document.documentElement.dataset.theme = 'dark';
				}
			})();
		</script>
	</head>
	<body class="bg-canvas font-sans text-ink antialiased">
		<div class="scroll-progress" aria-hidden="true"><div class="scroll-progress-bar" id="scroll-progress-bar"></div></div>
		<a href="#main-content" class="skip-link">Ir al contenido principal</a>
		<slot />
		<Footer />

		<button id="scroll-to-top" type="button" aria-label="Volver al inicio" class="invisible fixed bottom-6 right-6 z-40 flex h-11 w-11 items-center justify-center rounded-full bg-surface text-ink opacity-0 shadow-lg ring-1 ring-hairline transition-all duration-300 hover:bg-surface-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
		  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
		  </svg>
		</button>
	</body>
</html>

<script>
	import '../scripts/theme';
	import '../scripts/copy-buttons';
	import '../scripts/animations';
</script>
