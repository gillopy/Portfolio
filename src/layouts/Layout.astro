---
import siteConfig from '../data/siteConfig.json';

interface Props {
	title?: string;
	description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f8fafc" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<title>{title}</title>
		<script is:inline>
			const theme = localStorage.getItem('theme');
			const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			if (theme === 'dark' || (!theme && prefersDark)) document.documentElement.classList.add('dark');
		</script>
	</head>
	<body class="bg-section-light text-foreground font-sans antialiased transition-colors duration-300 dark:text-slate-100">
		<slot />

		<button id="scroll-to-top" aria-label="Volver al inicio" class="fixed bottom-6 right-6 z-40 rounded-full bg-primary p-3 text-white shadow-lg opacity-0 invisible transition-all duration-300 hover:bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950">
		  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
		  </svg>
		</button>
	</body>
</html>

<style is:global>
	/* Add global styles here */
	:root {
		color-scheme: light;
		--page-background: #f8fafc;
	}

	.dark {
		color-scheme: dark;
		--page-background: #0f172a;
	}

	body {
		background: var(--page-background);
	}

	::selection {
		background: #38bdf8;
		color: #082f49;
	}

	:focus-visible {
		outline: 2px solid #0ea5e9;
		outline-offset: 3px;
	}

	html {
		scroll-behavior: smooth;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in {
		animation: fadeIn 0.6s ease-in-out forwards;
	}

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}

	/* Add a delay to each child element */
	.delay-children > *:nth-child(1) { animation-delay: 0.1s; }
	.delay-children > *:nth-child(2) { animation-delay: 0.2s; }
	.delay-children > *:nth-child(3) { animation-delay: 0.3s; }
	.delay-children > *:nth-child(4) { animation-delay: 0.4s; }
	.delay-children > *:nth-child(5) { animation-delay: 0.5s; }

</style>

<script>
    const scrollToTopButton = document.getElementById('scroll-to-top');
    if (scrollToTopButton) {
      const updateScrollButton = () => {
        scrollToTopButton.classList.toggle('opacity-0', window.scrollY <= 300);
        scrollToTopButton.classList.toggle('invisible', window.scrollY <= 300);
        scrollToTopButton.classList.toggle('opacity-100', window.scrollY > 300);
        scrollToTopButton.classList.toggle('visible', window.scrollY > 300);
      };
      window.addEventListener('scroll', updateScrollButton, { passive: true });
      scrollToTopButton.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      updateScrollButton();
    }
</script>
