---
import profile from '../data/profile.json';
import { Image } from 'astro:assets';
---

<section id="sobre-mi" class="about bg-canvas py-24">
  <div class="container mx-auto px-6">
    <div class="scroll-reveal">
      <h2 class="section-title mb-16 font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
        <span class="section-title-underline">Sobre Mí</span>
      </h2>
    </div>

    <div class="about-content flex flex-col md:flex-row gap-12 lg:gap-16">
      <div class="about-image w-full md:w-2/5 lg:w-[35%] flex justify-center scroll-reveal">
        <div class="relative">
          
          <div class="relative aspect-square w-44 sm:w-48 lg:w-72 overflow-hidden rounded-full bg-surface p-1 ring-1 ring-hairline">
            <Image
              src={profile.profileImage}
              alt={profile.name}
              class="h-full w-full object-cover rounded-full relative z-10"
              width={400}
              height={400}
            />
          </div>
        </div>
      </div>

      <div class="about-text w-full md:w-3/5 lg:w-[65%] scroll-reveal">
        {profile.about.text.map((paragraph) => (
          <p class="mb-5 text-lg leading-relaxed text-ink-muted">
            {paragraph}
          </p>
        ))}

        <div class="about-details mt-10 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
          {profile.about.details.map((detail) => (
            <div class="detail border-t border-hairline-soft pt-3">
              <span class="block font-mono text-xs uppercase tracking-wider text-ink-muted/60 mb-1">{detail.label}</span>
              <span class="text-ink">{detail.value}</span>
            </div>
          ))}
        </div>

        <div class="about-buttons mt-10 flex justify-center md:justify-start">
          <a
            href={profile.about.cvLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Descargar CV
          </a>
        </div>
      </div>
    </div>
  </div>
</section>