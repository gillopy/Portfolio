---
import profile from '../data/profile.json';
import { Image } from 'astro:assets';
---

<section id="sobre-mi" class="about relative bg-canvas py-24">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-hairline to-transparent"></div>
  <div class="container mx-auto px-6">
    <div class="gsap-reveal mb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
          <span class="section-title-underline">Sobre Mí</span>
        </h2>
      </div>
      <p class="max-w-md font-mono text-xs leading-relaxed text-ink-faint">
        Enfoque cuantitativo + narrativa. Del dato crudo al insight accionable, con rigor estadístico y claridad ejecutiva.
      </p>
    </div>

    <div class="about-content flex flex-col md:flex-row gap-12 lg:gap-16">
      <div class="about-image w-full md:w-2/5 lg:w-[35%] flex justify-center">
        <div class="about-image-inner relative w-44 h-44 sm:w-52 sm:h-52 lg:w-72 lg:h-72 shrink-0">
          <!-- Halo/sombra detrás del retrato: el contenedor ya es cuadrado
               (w/h explícitos), así que inset-0 es circular. El halo va
               ligeramente inset para no desbordar el blur. -->
          <div class="pointer-events-none absolute inset-1 -z-10 rounded-full bg-[var(--blur-shade)] blur-[14px]"></div>
          <div class="pointer-events-none absolute inset-0 -z-10 rounded-full shadow-[var(--shadow-portrait)]"></div>
          <div class="relative h-full w-full overflow-hidden rounded-full bg-surface p-1 ring-1 ring-hairline">
            <Image
              src={profile.profileImage}
              alt={profile.name}
              class="h-full w-full object-cover rounded-full relative z-10"
              width={400}
              height={400}
            />
          </div>
        </div>
      </div>

      <div class="about-text w-full md:w-3/5 lg:w-[65%]">
        {profile.about.text.map((paragraph) => (
          <p class="mb-5 text-[1.05rem] leading-relaxed text-ink-muted">
            {paragraph}
          </p>
        ))}

        <div class="about-details mt-10 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
          {profile.about.details.map((detail) => (
            <div class="detail group border-t border-hairline-soft pt-3">
              <span class="block font-mono text-[11px] uppercase tracking-widest text-ink-faint mb-1">{detail.label}</span>
              <span class="text-sm text-ink group-hover:text-accent transition-colors">{detail.value}</span>
            </div>
          ))}
        </div>

        <div class="about-buttons mt-10 flex flex-wrap items-center gap-3">
          <a
            href={profile.about.cvLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Descargar CV
          </a>
          <a href="#contacto" class="btn-ghost">
            Iniciar conversación <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
