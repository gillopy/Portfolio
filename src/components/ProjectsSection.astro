---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import siteConfig from '../data/siteConfig.json';
import ProjectCard from './ProjectCard.astro';

const projects: CollectionEntry<'projects'>[] = (await getCollection('projects')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title)
);
---

<section id="proyectos" class="projects bg-canvas py-24">
  <div class="container mx-auto px-6">
    <div class="scroll-reveal">
      <h2 class="section-title mb-16 font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
        <span class="section-title-underline">Proyectos</span>
      </h2>
    </div>

    <div class="projects-grid grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((entry) => (
        <div class="scroll-reveal">
          <ProjectCard entry={entry} />
        </div>
      ))}
    </div>

    <div class="view-more-projects mt-14 text-center scroll-reveal">
      <a
        href={siteConfig.moreProjectsLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        Ver Más Proyectos
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>