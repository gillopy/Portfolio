---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import siteConfig from '../data/siteConfig.json';
import ProjectCard from './ProjectCard.astro';

const projects: CollectionEntry<'projects'>[] = (await getCollection('projects')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title)
);
---

<section id="proyectos" class="projects relative bg-canvas py-24">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-hairline to-transparent"></div>
  <div class="container mx-auto px-6">
    <div class="gsap-reveal mb-6 flex flex-wrap items-end justify-between gap-6">
      <div>
        <span class="section-eyebrow">02 — Selección</span>
        <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
          <span class="section-title-underline">Proyectos</span>
        </h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-muted">
          Casos de extremo a extremo: ingesta, modelado y despliegue. Cada ficha incluye código, métricas y narrativa.
        </p>
      </div>
      <div class="hidden items-center gap-2 font-mono text-xs text-ink-faint sm:flex">
        <span class="h-px w-8 bg-hairline"></span>
        {projects.length} estudios · 2023—2026
      </div>
    </div>
    <div class="section-rule mb-10"></div>

    <div class="projects-grid mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {projects.map((entry) => (
        <ProjectCard entry={entry} />
      ))}
    </div>

    <div class="view-more-projects mt-14 flex flex-col items-center gap-3 text-center">
      <a
        href={siteConfig.moreProjectsLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary group"
      >
        Ver Más Proyectos
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <span class="font-mono text-[11px] tracking-widest uppercase text-ink-faint">github.com/gillopy</span>
    </div>
  </div>
</section>
