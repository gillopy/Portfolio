---
import profile from '../data/profile.json';
import siteConfig from '../data/siteConfig.json';

const socialLinks = profile.social.filter(
  (social) => social.platform === 'LinkedIn' || social.platform === 'GitHub',
);
---

<style>
  .contact-field:focus-visible {
    outline: none;
  }
</style>

<section id="contacto" class="contact relative bg-canvas py-24">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-hairline to-transparent"></div>
  <div class="container mx-auto px-6">
    <div class="gsap-reveal mb-10">
      <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
        <span class="section-title-underline">Contacto</span>
      </h2>
    </div>
    <div class="section-rule mb-10"></div>

    <div class="contact-container grid min-w-0 grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <div class="contact-info flex min-w-0 flex-col rounded-2xl border border-hairline bg-canvas-2 p-6 sm:p-7">
        <h3 class="font-display text-2xl font-bold tracking-[-0.02em] text-ink">¿Deseas hablar?</h3>
        <p class="mt-4 max-w-[46ch] text-sm leading-7 text-ink-muted sm:text-base">
          La forma más directa de empezar es el formulario. Cuéntame qué quieres construir y qué resultado buscas.
        </p>

        <ul class="mt-6 border-t border-hairline" aria-label="Canales profesionales">
          {socialLinks.map((social) => (
            <li class="border-b border-hairline">
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.platform}: ${social.handle}`}
                class="group flex min-h-14 items-center gap-4 px-3 py-2.5 transition-colors duration-200 hover:bg-canvas focus-visible:bg-canvas"
              >
                <span class="flex h-6 w-6 shrink-0 items-center justify-center text-accent" aria-hidden="true">
                  {social.platform === 'LinkedIn' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z" />
                    </svg>
                  )}
                  {social.platform === 'GitHub' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 1.911 0 .653-.526 1.191-1.162 1.619.274.74.749 1.06 1.425 1.06.823 0 1.494-.83 1.494-2.303v-2.155c0-1.256.004-2.283-1.603-3.214 0 0 1.333-.432 2.733 1.649 2.79 0 4.857-1.385 4.857-1.385z" />
                    </svg>
                  )}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-xs font-medium text-ink-muted">{social.platform}</span>
                  <span class="mt-0.5 block truncate text-sm text-ink transition-colors group-hover:text-accent">{social.handle}</span>
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 shrink-0 text-ink-faint transition-transform duration-200 group-hover:translate-x-1 group-focus-visible:translate-x-1 group-focus-visible:text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-5">
          <span class="text-sm text-ink-muted">Respuesta</span>
          <span class="inline-flex items-center gap-2 text-sm font-medium text-ink">
            <span class="h-2 w-2 rounded-full bg-accent-3" aria-hidden="true"></span>
            &lt; 8 horas · Lun—Vie
          </span>
        </div>
      </div>

      <div class="contact-form min-w-0 rounded-2xl border border-hairline bg-surface p-6 sm:p-7">
        <div class="mb-5">
          <h3 id="contact-form-title" class="font-display text-2xl font-bold tracking-[-0.02em] text-ink">Cuéntame sobre tu proyecto</h3>
          <p id="contact-form-description" class="mt-3 max-w-[48ch] text-sm leading-6 text-ink-muted">
            Comparte el contexto y lo que quieres lograr.
          </p>
        </div>

        <form
          action={siteConfig.formEndpoint}
          method="POST"
          class="space-y-4"
          aria-labelledby="contact-form-title"
          aria-describedby="contact-form-description"
        >
          <div class="form-fields grid gap-4 lg:grid-cols-2">
            <div class="form-group">
              <label for="name" class="mb-1.5 block font-sans text-sm font-medium text-ink-muted">Nombre</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Guillermo Cabrera"
                class="contact-field min-h-11 w-full rounded-xl border border-hairline bg-canvas px-4 py-2.5 text-sm leading-6 text-ink transition-colors placeholder:text-ink-muted focus-visible:border-accent/70 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/10"
              />
            </div>

            <div class="form-group">
              <label for="email" class="mb-1.5 block font-sans text-sm font-medium text-ink-muted">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="nombre@ejemplo.com"
                class="contact-field min-h-11 w-full rounded-xl border border-hairline bg-canvas px-4 py-2.5 text-sm leading-6 text-ink transition-colors placeholder:text-ink-muted focus-visible:border-accent/70 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/10"
              />
            </div>

            <div class="form-group lg:col-span-2">
              <label for="message" class="mb-1.5 block font-sans text-sm font-medium text-ink-muted">Mensaje</label>
              <textarea
                id="message"
                name="message"
                rows="3"
                required
                placeholder="Cuéntame sobre tu proyecto, datos y objetivo..."
                class="contact-field min-h-28 w-full resize-y rounded-xl border border-hairline bg-canvas px-4 py-2.5 text-sm leading-6 text-ink transition-colors placeholder:text-ink-muted focus-visible:border-accent/70 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/10"
              ></textarea>
            </div>
          </div>

          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <button
            type="submit"
            class="group inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-accent/60 bg-surface-2 px-4 py-2.5 font-sans text-sm font-semibold normal-case tracking-normal text-ink transition-colors duration-200 hover:border-accent hover:bg-surface-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/30 sm:w-auto"
          >
            Enviar mensaje
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>

          <p class="mt-4 text-xs leading-5 text-ink-muted">Envío procesado mediante Formspree.</p>
        </form>
      </div>
    </div>
  </div>
</section>
