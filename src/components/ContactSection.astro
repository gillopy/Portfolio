---
import profile from '../data/profile.json';
import siteConfig from '../data/siteConfig.json';
---

<section id="contacto" class="contact relative bg-canvas py-24">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-hairline to-transparent"></div>
  <div class="container mx-auto px-6">
    <div class="gsap-reveal mb-10">
      <span class="section-eyebrow">04 — Contacto</span>
      <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
        <span class="section-title-underline">Contacto</span>
      </h2>
    </div>
    <div class="section-rule mb-10"></div>

    <div class="contact-container grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16">
      <div class="contact-info rounded-xl bg-surface p-6 ring-1 ring-hairline lg:p-7">
        <h3 class="mb-3 font-display text-xl font-bold tracking-tight text-ink">¿Desea hablar?</h3>
        <p class="mb-8 text-sm leading-relaxed text-ink-muted">
          Si tiene alguna consulta o desea discutir una posible colaboración,
          por favor utilice el formulario. Respuesta en menos de 24 h hábiles.
        </p>

        <div class="social-links space-y-4">
          {profile.social.map((social) => (
            <div class="info-item flex items-center gap-4 group">
              <div class="icon-container flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-canvas text-accent ring-1 ring-hairline transition-colors group-hover:ring-accent group-hover:text-ink">
                {social.platform === 'Email' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {social.platform === 'LinkedIn' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z" />
                  </svg>
                )}
                {social.platform === 'GitHub' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                )}
              </div>
              <div class="info-content min-w-0">
                <span class="block font-mono text-[11px] uppercase tracking-widest text-ink-faint">{social.platform}</span>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block truncate text-sm text-ink transition-colors hover:text-accent"
                >
                  {social.handle}
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 rounded-lg bg-canvas p-4 ring-1 ring-hairline">
          <span class="block font-mono text-[11px] uppercase tracking-widest text-ink-faint">Tiempo medio de respuesta</span>
          <span class="font-display text-lg font-bold tracking-tight text-ink">&lt; 8 horas <span class="font-mono text-xs font-normal text-emerald-400">· Lun—Vie</span></span>
        </div>
      </div>

      <div class="contact-form rounded-xl bg-surface p-6 ring-1 ring-hairline lg:p-7">
        <form
          action={siteConfig.formEndpoint}
          method="POST"
          class="space-y-5"
        >
          <div class="form-group">
            <label for="name" class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-ink-muted/60">Nombre</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder="Guillermo Cabrera"
              class="w-full rounded-lg border border-hairline bg-canvas px-4 py-3 text-ink placeholder:text-ink-muted/50 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15"
            />
          </div>

          <div class="form-group">
            <label for="email" class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-ink-muted/60">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="nombre@ejemplo.com"
              class="w-full rounded-lg border border-hairline bg-canvas px-4 py-3 text-ink placeholder:text-ink-muted/50 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15"
            />
          </div>

          <div class="form-group">
            <label for="message" class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-ink-muted/60">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Cuéntame sobre tu proyecto, datos y objetivo..."
              class="w-full resize-none rounded-lg border border-hairline bg-canvas px-4 py-3 text-ink placeholder:text-ink-muted/50 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/15"
            ></textarea>
          </div>

          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <button
            type="submit"
            class="btn-primary w-full md:w-auto justify-center group"
          >
            Enviar Mensaje
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
          <p class="font-mono text-[11px] text-ink-faint">Formspree · Sin spam · Datos no compartidos</p>
        </form>
      </div>
    </div>
  </div>
</section>
