---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { title, shortDescription, publishDate } = entry.data;
const href = `/articles/${entry.id}`;
const dateLabel = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' }).format(publishDate);
---

{/* Flat stacked row: title, date, short description. No image, tags, or button. */}
<article class="article-row gsap-reveal border-b border-hairline last:border-b-0">
  <a href={href} class="group block px-0 py-7">
    <h3 class="font-display text-lg font-bold leading-tight tracking-tight text-ink transition-colors duration-300 group-hover:text-accent md:text-xl">
      {title}
    </h3>
    <p class="mt-2 font-mono text-[11px] tracking-widest uppercase text-ink-faint">
      {dateLabel}
    </p>
    <p class="mt-3 text-sm leading-relaxed text-ink-muted">
      {shortDescription}
    </p>
  </a>
</article>
