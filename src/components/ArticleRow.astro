---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
  /** Heading level for the title: h3 under the home section's h2, h2 under the index page's h1. */
  headingLevel?: 2 | 3;
  /** Opt-in tag chips. Off in the home preview, on in the full archive. */
  showTags?: boolean;
  /** Opt-in cover thumbnail to the left of the text. Off in the home preview. */
  showCover?: boolean;
}

const { entry, headingLevel = 3, showTags = false, showCover = false } = Astro.props;
const { title, shortDescription, publishDate, tags, cover } = entry.data;
const href = `/articles/${entry.id}`;
// `z.coerce.date()` reads a date-only frontmatter string as UTC midnight, but
// Intl formats in the local zone. Behind UTC (Paraguay is UTC-4) that rendered
// every label one day EARLIER than the declared publishDate. Pinning the
// formatter to UTC round-trips the declared calendar date exactly.
const dateLabel = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(publishDate);
// Capitalized so Astro treats it as a dynamic element name. The `headingLevel`
// union above makes this provably an h2 or h3; the assertion narrows the
// template literal so the language server resolves the tag's attributes.
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{/* Flat stacked row: title, date, short description. Tags and the cover thumbnail
    are opt-in so the home preview stays image-free. */}
<article class="article-row gsap-reveal border-b border-hairline last:border-b-0">
  <a
    href={href}
    class:list={[
      'group block px-0 py-7',
      // The cover turns the row into a flex line so the text column can sit to
      // its right. Both classes are inert when showCover is false.
      showCover && 'flex items-start gap-5 sm:gap-6',
    ]}
  >
    {showCover && (
      /* Source covers have mixed ratios (1.51 and 1.78), so the fixed 4/3 box
         plus object-cover keeps the thumbnail column visually even. */
      <div class="aspect-[4/3] w-20 shrink-0 overflow-hidden rounded-md ring-1 ring-hairline sm:w-24 md:w-32">
        <Image
          src={cover}
          alt=""
          width={256}
          height={192}
          loading="lazy"
          class="h-full w-full object-cover object-center transition-opacity duration-300 group-hover:opacity-70"
        />
      </div>
    )}
    {/* min-w-0 lets long titles and URLs shrink instead of forcing the row wider. */}
    <div class="min-w-0 flex-1">
      <Heading class="font-display text-lg font-bold leading-tight tracking-tight text-ink transition-colors duration-300 group-hover:text-accent md:text-xl">
        {title}
      </Heading>
      <p class="mt-2 font-mono text-[11px] tracking-widest uppercase text-ink-faint">
        {dateLabel}
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">
        {shortDescription}
      </p>
      {showTags && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-muted ring-1 ring-hairline transition-colors duration-200 hover:text-accent">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>
