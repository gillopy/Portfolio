---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'articles'>;
  /** Heading level for the title: h3 under the home section's h2, h2 under the index page's h1. */
  headingLevel?: 2 | 3;
  /** Opt-in tag chips. Off in the home preview, on in the full archive. */
  showTags?: boolean;
}

const { entry, headingLevel = 3, showTags = false } = Astro.props;
const { title, shortDescription, publishDate, tags } = entry.data;
const href = `/articles/${entry.id}`;
const dateLabel = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' }).format(publishDate);
// Capitalized so Astro treats it as a dynamic element name. The `headingLevel`
// union above makes this provably an h2 or h3; the assertion narrows the
// template literal so the language server resolves the tag's attributes.
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

{/* Flat stacked row: title, date, short description. No image or button. Tags are opt-in via showTags. */}
<article class="article-row gsap-reveal border-b border-hairline last:border-b-0">
  <a href={href} class="group block px-0 py-7">
    <Heading class="font-display text-lg font-bold leading-tight tracking-tight text-ink transition-colors duration-300 group-hover:text-accent md:text-xl">
      {title}
    </Heading>
    <p class="mt-2 font-mono text-[11px] tracking-widest uppercase text-ink-faint">
      {dateLabel}
    </p>
    <p class="mt-3 text-sm leading-relaxed text-ink-muted">
      {shortDescription}
    </p>
    {showTags && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-muted ring-1 ring-hairline transition-colors duration-200 hover:text-accent">
            {tag}
          </span>
        ))}
      </div>
    )}
  </a>
</article>
