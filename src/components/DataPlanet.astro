    x: number;
    y: number;
    z: number;
  }

  interface SurfacePoint extends Vec3 {
    kind: 'land' | 'ocean';
    size: number;
    phase: number;
    tone: number;
    node: boolean;
  }

  interface RGB {
    r: number;
    g: number;
    b: number;
  }

  interface Palette {
    surface: RGB;
    inkMuted: RGB;
    inkFaint: RGB;
    accent: RGB;
    accent2: RGB;
    accent3: RGB;
  }

  type GeoCoordinate = [longitude: number, latitude: number];

  interface GeoPolygon {
    name: string;
    points: GeoCoordinate[];
    tone: number;
  }

  interface NetworkLink {
    a: number;
    b: number;
    strength: number;
  }

  type AccentKey = 'accent' | 'accent2' | 'accent3';
  type IconKind = 'database' | 'model' | 'container' | 'inference';

