  // Soft key light (view space) giving the point field a gentle terminator.
  const LIGHT = (() => {
    const x = -0.35;
    const y = 0.5;
    const z = 0.8;
    const len = Math.hypot(x, y, z);
    return { x: x / len, y: y / len, z: z / len };
  })();

  // Shared transform scratch: draws never interleave (single-threaded), so one
  // module-level buffer is enough even with multiple planets on a page.
  const scratch: Xf = { x: 0, y: 0, z: 0 };

  const controllers = new Map<HTMLElement, Controller>();

  function clamp(value: number, min: number, max: number): number {
    return Math.max(min, Math.min(max, value));
  }

  function createSeededRandom(seed: number): () => number {
    let value = seed >>> 0;
    return () => {
      value += 0x6d2b79f5;
      let t = value;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function unitVector(x: number, y: number, z: number): Vec3 {
    const length = Math.hypot(x, y, z) || 1;
    return { x: x / length, y: y / length, z: z / length };
  }

  function parseHex(value: string, fallback: RGB): RGB {
    const hex = value.trim().replace(/^#/, '');
    const short = hex.length === 3 && /^[0-9a-f]{3}$/i.test(hex);
    const long = hex.length === 6 && /^[0-9a-f]{6}$/i.test(hex);
    if (!short && !long) return fallback;
    const full = short
      ? hex
          .split('')
          .map((c) => c + c)
          .join('')
      : hex;
    const num = Number.parseInt(full, 16);
    if (Number.isNaN(num)) return fallback;
    return { r: (num >> 16) & 255, g: (num >> 8) & 255, b: num & 255 };
  }

  function readPalette(): Palette {
    const styles = getComputedStyle(document.documentElement);
    const value = (name: string) => styles.getPropertyValue(name).trim();
    return {
      surface: parseHex(value('--color-surface'), { r: 12, g: 14, b: 18 }),
      inkMuted: parseHex(value('--color-ink-muted'), { r: 153, g: 153, b: 153 }),
      inkFaint: parseHex(value('--color-ink-faint'), { r: 107, g: 107, b: 107 }),
      accent: parseHex(value('--color-accent'), { r: 0, g: 153, b: 255 }),
      accent2: parseHex(value('--color-accent-2'), { r: 124, g: 92, b: 255 }),
      accent3: parseHex(value('--color-accent-3'), { r: 198, g: 255, b: 74 }),
    };
  }

  function rgba(color: RGB, alpha: number): string {
    return `rgba(${color.r}, ${color.g}, ${color.b}, ${alpha})`;
  }

  function shortestLongitudeDelta(delta: number): number {
    return ((delta + 180) % 360 + 360) % 360 - 180;
  }

  function pointInGeoPolygon(point: GeoCoordinate, polygon: GeoPolygon): boolean {
    const [longitude, latitude] = point;
    const ring = polygon.points;
    let unwrapped = ring[0][0];
    let longitudeSum = unwrapped;

    for (let i = 1; i < ring.length; i += 1) {
      unwrapped += shortestLongitudeDelta(ring[i][0] - ring[i - 1][0]);
      longitudeSum += unwrapped;
    }

    // Shift the complete unwrapped ring near the query. This keeps distant
    // polygons outside the query while preserving dateline-crossing edges.
    const offset =
      longitude + 360 * Math.round((longitudeSum / ring.length - longitude) / 360);
    let previousX = unwrapped - offset;
    let previousY = ring[ring.length - 1][1];
    let currentUnwrapped = ring[0][0] - offset;
    let winding = 0;

    for (let i = 0; i < ring.length; i += 1) {
      if (i > 0) currentUnwrapped += shortestLongitudeDelta(ring[i][0] - ring[i - 1][0]);
      const currentX = currentUnwrapped;
      const currentY = ring[i][1];
      const side =
        (currentX - previousX) * (latitude - previousY) -
        (currentY - previousY) * (0 - previousX);

      if (previousY <= latitude && currentY > latitude && side > 0) winding += 1;
      if (previousY > latitude && currentY <= latitude && side < 0) winding -= 1;
      previousX = currentX;
      previousY = currentY;
    }

    return winding !== 0;
  }

  function continentFor(point: Vec3): number {
    const coordinate: GeoCoordinate = [
      (Math.atan2(point.z, point.x) * 180) / Math.PI,
      (Math.asin(clamp(point.y, -1, 1)) * 180) / Math.PI,
    ];
    for (let i = 0; i < LAND_POLYGONS.length; i += 1) {
      if (pointInGeoPolygon(coordinate, LAND_POLYGONS[i])) return i;
    }
    return -1;
  }

  function evenlySample<T>(items: T[], max: number): T[] {
    if (items.length <= max) return items;
    const stride = items.length / max;
    const sampled: T[] = [];
    for (let i = 0; i < max; i += 1) sampled.push(items[Math.floor(i * stride)]);
    return sampled;
  }

  /** Build a deterministic, clustered surface field once per page. */
  function buildSurface(): SurfacePoint[] {
    const random = createSeededRandom(SURFACE_SEED);
    const land: SurfacePoint[] = [];
    const ocean: SurfacePoint[] = [];

    for (let i = 0; i < SURFACE_SAMPLE_COUNT; i += 1) {
      const y = 1 - (2 * (i + 0.5)) / SURFACE_SAMPLE_COUNT;
      const ring = Math.sqrt(Math.max(0, 1 - y * y));
      const theta = GOLDEN_ANGLE * i + (random() - 0.5) * 0.12;
      const point = unitVector(
        Math.cos(theta) * ring,
        y + (random() - 0.5) * 0.006,
        Math.sin(theta) * ring,
      );
      const polygonIndex = continentFor(point);
      const kind = polygonIndex >= 0 ? 'land' : 'ocean';
      const surfacePoint: SurfacePoint = {
        ...point,
        kind,
        size: kind === 'land' ? 0.72 + random() * 0.9 : 0.42 + random() * 0.56,
        phase: random() * TAU,
        tone: polygonIndex >= 0 ? LAND_POLYGONS[polygonIndex].tone : 0,
        node: kind === 'land' && random() > 0.91,
      };
      (kind === 'land' ? land : ocean).push(surfacePoint);
    }

    return [...evenlySample(land, LAND_POINT_COUNT), ...evenlySample(ocean, OCEAN_POINT_COUNT)];
  }

  /** Precompute sparse local links once; the render loop never searches an O(n²) graph. */
  function buildLandLinks(points: SurfacePoint[]): NetworkLink[] {
    const buckets = new Map<string, number[]>();
    const links: NetworkLink[] = [];
    const cellKey = (x: number, y: number, z: number): string =>
      `${Math.floor((x + 1) / LINK_CELL_SIZE)}:${Math.floor((y + 1) / LINK_CELL_SIZE)}:${Math.floor(
        (z + 1) / LINK_CELL_SIZE,
      )}`;

    for (let i = 0; i < points.length; i += 1) {
      const point = points[i];
      const cellX = Math.floor((point.x + 1) / LINK_CELL_SIZE);
      const cellY = Math.floor((point.y + 1) / LINK_CELL_SIZE);
      const cellZ = Math.floor((point.z + 1) / LINK_CELL_SIZE);

      for (let dx = -1; dx <= 1; dx += 1) {
        for (let dy = -1; dy <= 1; dy += 1) {
          for (let dz = -1; dz <= 1; dz += 1) {
            const bucket = buckets.get(`${cellX + dx}:${cellY + dy}:${cellZ + dz}`);
            if (!bucket) continue;
            for (const j of bucket) {
              if (j <= i) continue;
              const other = points[j];
              const distance =
                (point.x - other.x) ** 2 +
                (point.y - other.y) ** 2 +
                (point.z - other.z) ** 2;
              if (distance > MAX_LINK_DISTANCE ** 2) continue;
              links.push({
                a: i,
                b: j,
                strength: 1 - Math.sqrt(distance) / MAX_LINK_DISTANCE,
              });
              if (links.length >= MAX_LAND_LINKS) return links;
            }
          }
        }
      }

      const key = cellKey(point.x, point.y, point.z);
      const bucket = buckets.get(key);
      if (bucket) bucket.push(i);
      else buckets.set(key, [i]);
    }

    return links;
  }

  /** Half-meridians: one polyline per longitude, pole to pole. */
  function buildMeridians(lons: number[], samples: number): Vec3[][] {
    return lons.map((lon) => {
      const line: Vec3[] = [];
      for (let s = 0; s <= samples; s += 1) {
        const lat = -Math.PI / 2 + (Math.PI * s) / samples;
        line.push({
          x: Math.cos(lat) * Math.cos(lon),
          y: Math.sin(lat),
          z: Math.cos(lat) * Math.sin(lon),
        });
      }
      return line;
    });
  }

  /** Full circle in the XZ plane at the given latitude (unit radius). */
  function buildCircle(lat: number, samples: number): Vec3[] {
    const line: Vec3[] = [];
    for (let s = 0; s <= samples; s += 1) {
      const lon = (TAU * s) / samples;
      line.push({
        x: Math.cos(lat) * Math.cos(lon),
        y: Math.sin(lat),
        z: Math.cos(lat) * Math.sin(lon),
      });
    }
    return line;
  }

  /**
   * Split a projected polyline into front/back Path2D halves so occlusion can
   * be staged: orbit backs first, sphere next, orbit fronts last.
   */
  function buildLinePaths(
    points: Vec3[],
    project: (p: Vec3, out: Xf) => void,
    cx: number,
    cy: number,
    radius: number,
  ): LinePaths {
    const front = new Path2D();
    const back = new Path2D();
    let prevFront: boolean | null = null;
    for (const point of points) {
      project(point, scratch);
      const sx = cx + scratch.x * radius;
      const sy = cy - scratch.y * radius;
      const isFront = scratch.z >= 0;
      if (prevFront === null) {
        (isFront ? front : back).moveTo(sx, sy);
      } else if (isFront === prevFront) {
        (isFront ? front : back).lineTo(sx, sy);
      } else {
        (prevFront ? front : back).lineTo(sx, sy);
        (isFront ? front : back).moveTo(sx, sy);
      }
      prevFront = isFront;
    }
    return { front, back };
  }

  function drawSatelliteIcon(
    ctx: CanvasRenderingContext2D,
    kind: IconKind,
    size: number,
  ): void {
    const s = size;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    if (kind === 'database') {
      ctx.beginPath();
      ctx.ellipse(0, -s * 0.46, s * 0.72, s * 0.2, 0, 0, TAU);
      ctx.moveTo(-s * 0.72, -s * 0.46);
      ctx.lineTo(-s * 0.72, s * 0.42);
      ctx.ellipse(0, s * 0.42, s * 0.72, s * 0.2, 0, Math.PI, 0, true);
      ctx.moveTo(s * 0.72, -s * 0.46);
      ctx.lineTo(s * 0.72, s * 0.42);
      ctx.moveTo(-s * 0.72, s * 0.02);
      ctx.ellipse(0, s * 0.02, s * 0.72, s * 0.2, 0, 0, Math.PI);
      ctx.stroke();
      return;
    }

    if (kind === 'container') {
      ctx.beginPath();
      ctx.strokeRect(-s * 0.74, -s * 0.54, s * 1.48, s * 1.08);
      ctx.moveTo(-s * 0.5, -s * 0.54);
      ctx.lineTo(-s * 0.5, s * 0.54);
      ctx.moveTo(s * 0.5, -s * 0.54);
      ctx.lineTo(s * 0.5, s * 0.54);
      ctx.moveTo(-s * 0.74, 0);
      ctx.lineTo(s * 0.74, 0);
      ctx.stroke();
      return;
    }

    if (kind === 'model') {
      ctx.beginPath();
      for (let i = 0; i < 6; i += 1) {
        const angle = -Math.PI / 2 + (TAU * i) / 6;
        const x = Math.cos(angle) * s * 0.72;
        const y = Math.sin(angle) * s * 0.72;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.moveTo(0, -s * 0.22);
      ctx.lineTo(0, s * 0.32);
      ctx.moveTo(-s * 0.22, s * 0.05);
      ctx.lineTo(s * 0.22, s * 0.05);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(0, s * 0.05, s * 0.14, 0, TAU);
      ctx.stroke();
      return;
    }

    const inputs = [
      { x: -s * 0.72, y: -s * 0.42 },
      { x: -s * 0.72, y: 0 },
      { x: -s * 0.72, y: s * 0.42 },
    ];
    const hidden = [
      { x: -s * 0.12, y: -s * 0.24 },
      { x: -s * 0.12, y: s * 0.24 },
    ];
    const output = { x: s * 0.72, y: 0 };
    ctx.beginPath();
    for (const input of inputs) {
      for (const node of hidden) {
        ctx.moveTo(input.x, input.y);
        ctx.lineTo(node.x, node.y);
      }
    }
    for (const node of hidden) {
      ctx.moveTo(node.x, node.y);
      ctx.lineTo(output.x, output.y);
    }
    ctx.stroke();
    ctx.beginPath();
    for (const node of [...inputs, ...hidden, output]) {
      ctx.moveTo(node.x + s * 0.12, node.y);
      ctx.arc(node.x, node.y, s * 0.12, 0, TAU);
    }
    ctx.stroke();
  }

  const surface = buildSurface();
  const landPoints = surface.filter((point) => point.kind === 'land');
  const landLinks = buildLandLinks(landPoints);
  const meridians = buildMeridians(MERIDIAN_LONGITUDES, MERIDIAN_SAMPLES);
  const latitudeRings = [buildCircle(0.64, ORBIT_SAMPLES), buildCircle(0, ORBIT_SAMPLES), buildCircle(-0.64, ORBIT_SAMPLES)];
  const orbitRing = buildCircle(0, ORBIT_SAMPLES);

  function createController(stage: HTMLElement, canvas: HTMLCanvasElement): Controller {
    const ctx = canvas.getContext('2d');
    const reduceQuery = matchMedia('(prefers-reduced-motion: reduce)');

    let palette = readPalette();
    let width = 0;
    let height = 0;
    let dpr = 1;
    let time = 0;
    let lastTs = 0;
    let rafId = 0;
    let inView = true;
    let destroyed = false;
    let targetPX = 0;
    let targetPY = 0;
    let curPX = 0;
    let curPY = 0;

    // Per-frame trig, captured by the projection helpers below.
    let cosS = 1;
    let sinS = 0;
    let cosP = 1;
    let sinP = 0;
    let cosY = 1;
    let sinY = 0;

    if (!ctx) {
      return {
        destroy: () => {
          destroyed = true;
        },
      };
    }

    // Sphere-surface point: spin about Y, then camera pitch (X) and yaw (Y).
    const spinPoint = (point: Vec3, out: Xf): void => {
      const x1 = point.x * cosS + point.z * sinS;
      const z1 = -point.x * sinS + point.z * cosS;
      const y2 = point.y * cosP - z1 * sinP;
      const z2 = point.y * sinP + z1 * cosP;
      out.x = x1 * cosY + z2 * sinY;
      out.z = -x1 * sinY + z2 * cosY;
      out.y = y2;
    };

    // Orbit-space point: tilt about X then Z, then the camera (no planet spin).
    const orbitTransform = (
      x0: number,
      y0: number,
      z0: number,
      cosOX: number,
      sinOX: number,
      cosOZ: number,
      sinOZ: number,
      out: Xf,
    ): void => {
      const y1 = y0 * cosOX - z0 * sinOX;
      const z1 = y0 * sinOX + z0 * cosOX;
      const x2 = x0 * cosOZ - y1 * sinOZ;
      const y2 = x0 * sinOZ + y1 * cosOZ;
      const y3 = y2 * cosP - z1 * sinP;
      const z3 = y2 * sinP + z1 * cosP;
      out.x = x2 * cosY + z3 * sinY;
      out.z = -x2 * sinY + z3 * cosY;
      out.y = y3;
    };

    const orbitPoint = (def: OrbitDef, angle: number, out: Xf): void => {
      orbitTransform(
        Math.cos(angle) * def.radius,
        0,
        Math.sin(angle) * def.radius,
        Math.cos(def.tiltX),
        Math.sin(def.tiltX),
        Math.cos(def.tiltZ),
        Math.sin(def.tiltZ),
        out,
      );
    };

    const colorOf = (def: OrbitDef): RGB => palette[def.color];
    const surfaceColor = (point: SurfacePoint): RGB => {
      if (point.tone === 2) return palette.accent3;
      if (point.tone === 1) return palette.accent2;
      return palette.accent;
    };

    const drawNetwork = (front: boolean, cx: number, cy: number, radius: number, scale: number): void => {
      ctx.lineWidth = Math.max(0.45, scale * 0.52);
      for (const link of landLinks) {
        spinPoint(landPoints[link.a], scratch);
        const ax = cx + scratch.x * radius;
        const ay = cy - scratch.y * radius;
        const az = scratch.z;
        spinPoint(landPoints[link.b], scratch);
        const bx = cx + scratch.x * radius;
        const by = cy - scratch.y * radius;
        const bz = scratch.z;
        const aFront = az >= 0;
        const bFront = bz >= 0;
        if (aFront !== bFront || aFront !== front) continue;
        const depth = clamp((az + bz + 2) / 4, 0, 1);
        const alpha = (front ? 0.15 : 0.05) * link.strength * (0.35 + depth * 0.65);
        if (alpha < 0.008) continue;
        ctx.strokeStyle = rgba(palette.accent, alpha);
        ctx.beginPath();
        ctx.moveTo(ax, ay);
        ctx.lineTo(bx, by);
        ctx.stroke();
      }
    };

    const drawGraticule = (front: boolean, cx: number, cy: number, radius: number, lineWidth: number): void => {
      ctx.lineWidth = lineWidth;
      for (const line of meridians) {
        const paths = buildLinePaths(line, spinPoint, cx, cy, radius);
        ctx.strokeStyle = rgba(palette.inkFaint, front ? 0.1 : 0.035);
        ctx.stroke(front ? paths.front : paths.back);
      }
      for (const line of latitudeRings) {
        const paths = buildLinePaths(line, spinPoint, cx, cy, radius);
        ctx.strokeStyle = rgba(palette.inkFaint, front ? 0.08 : 0.03);
        ctx.stroke(front ? paths.front : paths.back);
      }
    };

    const drawOrbitPulse = (
      def: OrbitDef,
      front: boolean,
      staticFrame: boolean,
      cx: number,
      cy: number,
      radius: number,
      scale: number,
    ): void => {
      if (staticFrame) return;
      const cycle = (time * PULSE_CYCLE + def.pulseOffset) % 1;
      if (cycle >= PULSE_VISIBLE) return;
      const travel = cycle / PULSE_VISIBLE;
      orbitPoint(def, def.phase + travel * TAU, scratch);
      const sx = cx + scratch.x * radius;
      const sy = cy - scratch.y * radius;
      const isFront = scratch.z >= 0;
      if (isFront !== front) return;
      const withinDisc = (sx - cx) ** 2 + (sy - cy) ** 2 < radius * radius;
      if (!isFront && withinDisc) return;
      const alpha = Math.sin(travel * Math.PI) * (isFront ? 0.72 : 0.24);
      const size = Math.max(1.1, 1.65 * scale);
      const color = colorOf(def);
      const glow = ctx.createRadialGradient(sx, sy, 0, sx, sy, size * 3.8);
      glow.addColorStop(0, rgba(color, alpha));
      glow.addColorStop(1, rgba(color, 0));
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(sx, sy, size * 3.8, 0, TAU);
      ctx.fill();
      ctx.fillStyle = rgba(color, alpha);
      ctx.fillRect(sx - size / 2, sy - size / 2, size, size);
    };

    const drawSatellite = (
      def: OrbitDef,
      front: boolean,
      staticFrame: boolean,
      cx: number,
      cy: number,
      radius: number,
      scale: number,
    ): void => {
      const angle = def.phase + (staticFrame ? 0 : time * def.speed);
      orbitPoint(def, angle, scratch);
      const sx = cx + scratch.x * radius;
      const sy = cy - scratch.y * radius;
      const isFront = scratch.z >= 0;
      if (isFront !== front) return;
      const withinDisc = (sx - cx) ** 2 + (sy - cy) ** 2 < radius * radius;
      if (!isFront && withinDisc) return;

      const color = colorOf(def);
      const breath = staticFrame ? 1 : 0.92 + Math.sin(time * 0.72 + def.phase) * 0.08;
      const alpha = (front ? 0.92 : 0.34) * breath;
      const iconSize = Math.max(6, 9.2 * scale) * breath;
      const glowRadius = iconSize * 2.1;
      const glow = ctx.createRadialGradient(sx, sy, 0, sx, sy, glowRadius);
      glow.addColorStop(0, rgba(color, 0.22 * alpha));
      glow.addColorStop(1, rgba(color, 0));
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(sx, sy, glowRadius, 0, TAU);
      ctx.fill();

      ctx.save();
      ctx.translate(sx, sy);
      ctx.rotate(staticFrame ? 0 : Math.sin(time * 0.16 + def.phase) * 0.035);
      ctx.strokeStyle = rgba(color, alpha);
      ctx.lineWidth = Math.max(0.7, scale * 0.78);
      drawSatelliteIcon(ctx, def.icon, iconSize);
      ctx.restore();
    };

    const draw = (): void => {
      if (width < 4 || height < 4) return;
      const staticFrame = reduceQuery.matches;
      const spin = staticFrame ? STATIC_SPIN : STATIC_SPIN + time * SPIN_SPEED;
      const parX = staticFrame ? 0 : curPX;
      const parY = staticFrame ? 0 : curPY;

      cosS = Math.cos(spin);
      sinS = Math.sin(spin);
      const pitch = BASE_TILT + parY;
      cosP = Math.cos(pitch);
      sinP = Math.sin(pitch);
      cosY = Math.cos(parX);
      sinY = Math.sin(parX);

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height / 2;
      const radius = Math.min(width, height) * 0.3;
      const scale = Math.max(0.7, radius / 125);
      const lineWidth = Math.max(0.55, Math.min(0.9, scale * 0.7));
      const orbitPaths: LinePaths[] = [];

      // --- 1. orbit backs and sparse pulse traffic behind the globe ---
      for (const def of ORBIT_DEFS) {
        const paths = buildLinePaths(
          orbitRing,
          (point, out) => {
            orbitTransform(
              point.x * def.radius,
              point.y * def.radius,
              point.z * def.radius,
              Math.cos(def.tiltX),
              Math.sin(def.tiltX),
              Math.cos(def.tiltZ),
              Math.sin(def.tiltZ),
              out,
            );
          },
          cx,
          cy,
          radius,
        );
        orbitPaths.push(paths);
        ctx.lineWidth = lineWidth;
        ctx.strokeStyle = rgba(colorOf(def), 0.065);
        ctx.stroke(paths.back);
        drawOrbitPulse(def, false, staticFrame, cx, cy, radius, scale);
        drawSatellite(def, false, staticFrame, cx, cy, radius, scale);
      }

      // --- 2. rear graticule and rear land network ---
      drawGraticule(false, cx, cy, radius, lineWidth);
      drawNetwork(false, cx, cy, radius, scale);

      // --- 3. a solid, theme-aware globe occludes the rear hemisphere ---
      const body = ctx.createRadialGradient(
        cx - radius * 0.36,
        cy - radius * 0.42,
        radius * 0.04,
        cx,
        cy,
        radius,
      );
      body.addColorStop(0, rgba(palette.surface, 0.98));
      body.addColorStop(0.7, rgba(palette.surface, 0.92));
      body.addColorStop(1, rgba(palette.surface, 0.7));
      ctx.fillStyle = body;
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, TAU);
      ctx.fill();

      const bodyLight = ctx.createRadialGradient(
        cx - radius * 0.34,
        cy - radius * 0.38,
        0,
        cx - radius * 0.2,
        cy - radius * 0.2,
        radius * 1.15,
      );
      bodyLight.addColorStop(0, rgba(palette.accent, 0.12));
      bodyLight.addColorStop(0.48, rgba(palette.accent, 0.035));
      bodyLight.addColorStop(1, rgba(palette.accent, 0));
      ctx.fillStyle = bodyLight;
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, TAU);
      ctx.fill();

      // --- 4. ocean field, land masses, and selected data nodes ---
      for (const point of surface) {
        spinPoint(point, scratch);
        const sx = cx + scratch.x * radius;
        const sy = cy - scratch.y * radius;
        const depth = clamp((scratch.z + 1) / 2, 0, 1);
        const light = Math.max(
          0,
          scratch.x * LIGHT.x + scratch.y * LIGHT.y + scratch.z * LIGHT.z,
        );
        const shimmer = staticFrame ? 1 : 0.88 + Math.sin(time * 0.58 + point.phase) * 0.12;
        const lightFactor = 0.58 + light * 0.42;
        const isLand = point.kind === 'land';
        const color = isLand ? surfaceColor(point) : palette.inkMuted;
        const alpha = isLand
          ? (0.22 + depth * 0.64) * lightFactor * shimmer
          : (0.07 + depth * 0.18) * lightFactor;
        const size = point.size * (0.72 + depth * 0.42) * scale;
        ctx.fillStyle = rgba(color, alpha);
        ctx.fillRect(sx - size / 2, sy - size / 2, size, size);

        if (isLand && point.node && depth > 0.42) {
          const nodeSize = Math.max(2.2, size * 2.6);
          ctx.strokeStyle = rgba(color, alpha * 0.42);
          ctx.lineWidth = Math.max(0.45, scale * 0.48);
          ctx.strokeRect(sx - nodeSize / 2, sy - nodeSize / 2, nodeSize, nodeSize);
        }
      }

      // --- 5. front graticule and front land network ---
      drawGraticule(true, cx, cy, radius, lineWidth);
      drawNetwork(true, cx, cy, radius, scale);

      // --- 6. front orbit halves, breathing icons, and pulse traffic ---
      ORBIT_DEFS.forEach((def, index) => {
        ctx.lineWidth = lineWidth;
        ctx.strokeStyle = rgba(colorOf(def), 0.19);
        ctx.stroke(orbitPaths[index].front);
        drawOrbitPulse(def, true, staticFrame, cx, cy, radius, scale);
        drawSatellite(def, true, staticFrame, cx, cy, radius, scale);
      });

      // A restrained limb highlight gives the silhouette a planetary edge.
      ctx.lineWidth = Math.max(0.6, scale * 0.62);
      ctx.strokeStyle = rgba(palette.accent, 0.14);
      ctx.beginPath();
      ctx.arc(cx, cy, radius, Math.PI * 0.76, Math.PI * 1.64);
      ctx.stroke();
    };

    const shouldRun = (): boolean =>
      !destroyed &&
      !reduceQuery.matches &&
      inView &&
      !document.hidden &&
      stage.isConnected;

    const destroy = (): void => {
      if (destroyed) return;
      destroyed = true;
      stop();
      ro.disconnect();
      io.disconnect();
      themeObserver.disconnect();
      reduceQuery.removeEventListener('change', onReduceChange);
      document.removeEventListener('visibilitychange', onVisibility);
      stage.removeEventListener('pointermove', onPointerMove);
      stage.removeEventListener('pointerleave', onPointerLeave);
      controllers.delete(stage);
    };

    const frame = (ts: number): void => {
      rafId = 0;
      if (!stage.isConnected) {
        destroy();
        return;
      }
      const dt = Math.min((ts - lastTs) / 1000, 0.06);
      lastTs = ts;
      time += dt;
      const k = 1 - Math.exp(-dt * 7);
      curPX += (targetPX - curPX) * k;
      curPY += (targetPY - curPY) * k;
      draw();
      if (shouldRun()) rafId = requestAnimationFrame(frame);
    };

    function start(): void {
      if (rafId || !shouldRun()) return;
      lastTs = performance.now();
      rafId = requestAnimationFrame(frame);
    }

    function stop(): void {
      if (!rafId) return;
      cancelAnimationFrame(rafId);
      rafId = 0;
    }

    const resize = (): void => {
      const rect = stage.getBoundingClientRect();
      const w = Math.round(rect.width);
      const h = Math.round(rect.height);
      if (w < 4 || h < 4) return;
      const nextDpr = Math.min(window.devicePixelRatio || 1, 2);
      if (w === width && h === height && nextDpr === dpr) return;
      width = w;
      height = h;
      dpr = nextDpr;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      draw();
    };

    const ro = new ResizeObserver(() => {
      resize();
    });
    ro.observe(stage);

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) inView = entry.isIntersecting;
        if (inView) {
          draw();
          start();
        } else {
          stop();
        }
      },
      { threshold: 0 },
    );
    io.observe(stage);

    function onVisibility(): void {
      if (document.hidden) stop();
      else start();
    }
    document.addEventListener('visibilitychange', onVisibility);

    const onPointerMove = (e: PointerEvent): void => {
      if (e.pointerType !== 'mouse' || reduceQuery.matches) return;
      const rect = stage.getBoundingClientRect();
      if (rect.width < 4 || rect.height < 4) return;
      targetPX = ((e.clientX - rect.left) / rect.width - 0.5) * PARALLAX_MAX * 2;
      targetPY = ((e.clientY - rect.top) / rect.height - 0.5) * PARALLAX_MAX * 2;
    };
    const onPointerLeave = (): void => {
      targetPX = 0;
      targetPY = 0;
    };
    stage.addEventListener('pointermove', onPointerMove);
    stage.addEventListener('pointerleave', onPointerLeave);

    function onReduceChange(): void {
      targetPX = 0;
      targetPY = 0;
      curPX = 0;
      curPY = 0;
      if (reduceQuery.matches) {
        stop();
        draw();
      } else {
        start();
      }
    }
    reduceQuery.addEventListener('change', onReduceChange);

    const themeObserver = new MutationObserver(() => {
      palette = readPalette();
      draw();
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    resize();
    start();

    return { destroy };
  }

  function initPlanets(): void {
    document.querySelectorAll<HTMLElement>('[data-planet]').forEach((stage) => {
      if (controllers.has(stage)) return;
      const canvas = stage.querySelector<HTMLCanvasElement>('canvas[data-planet-canvas]');
      if (!canvas) return;
      controllers.set(stage, createController(stage, canvas));
    });
    // Sweep instances whose stage left the DOM without a router event.
    for (const [stage, controller] of controllers) {
      if (!stage.isConnected) controller.destroy();
    }
  }

  function destroyPlanets(): void {
    for (const controller of [...controllers.values()]) controller.destroy();
    controllers.clear();
  }

  initPlanets();
  document.addEventListener('astro:page-load', initPlanets);
  document.addEventListener('astro:after-swap', initPlanets);
  document.addEventListener('astro:before-preparation', destroyPlanets);
</script>
