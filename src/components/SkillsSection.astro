---
import skills from '../data/skills.json';
---

<section id="habilidades" class="skills relative bg-canvas py-24">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-hairline to-transparent"></div>
  <div class="container mx-auto px-6">
    <div class="gsap-reveal mb-12">
      <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
        <span class="section-title-underline">Herramientas y Tecnologías</span>
      </h2>
      <p class="mt-5 font-mono text-xs tracking-widest uppercase text-ink-faint">
        Stack probado en producción
      </p>
    </div>
    <div class="section-rule mb-14"></div>

    <div class="flex flex-col gap-6 pt-2">
      <div class="tools-ticker gsap-reveal" aria-label="Herramientas y tecnologías — fila 1">
        <div class="ticker-track ticker-track--reverse">
          <div class="ticker-group">
            {skills.tools.map((tool) => (
              <span class="ticker-item">{tool}</span>
            ))}
          </div>
          <div class="ticker-group" aria-hidden="true">
            {skills.tools.map((tool) => (
              <span class="ticker-item" tabindex="-1">{tool}</span>
            ))}
          </div>
        </div>
      </div>
      <div class="tools-ticker gsap-reveal" aria-label="Herramientas y tecnologías — fila 2">
        <div class="ticker-track">
          <div class="ticker-group">
            {skills.tools.map((tool) => (
              <span class="ticker-item">{tool}</span>
            ))}
          </div>
          <div class="ticker-group" aria-hidden="true">
            {skills.tools.map((tool) => (
              <span class="ticker-item" tabindex="-1">{tool}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  for (const ticker of document.querySelectorAll('.tools-ticker')) {
    const track = ticker.querySelector('.ticker-track') as HTMLElement | null;
    if (!track) continue;
    const anims = () => (track.getAnimations() as Animation[]);
    const setRate = (r: number) => anims().forEach((a) => { try { a.playbackRate = r; } catch {} });
    ticker.addEventListener('mouseenter', () => setRate(0.33));
    ticker.addEventListener('mouseleave', () => setRate(1));
    ticker.addEventListener('focusin', () => setRate(0.33));
    ticker.addEventListener('focusout', () => setRate(1));
  }
</script>
