---
import skills from '../data/skills.json';
---

<section id="habilidades" class="skills relative bg-canvas py-24">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-hairline to-transparent"></div>
  <div class="container mx-auto px-6">
    <div class="gsap-reveal mb-10">
      <span class="section-eyebrow">03 — Capacidades</span>
      <h2 class="font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
        <span class="section-title-underline">Habilidades</span>
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-muted">
        Métricas auditables, no buzzwords. Cada barra refleja uso en producción, no autoevaluación vacía.
      </p>
    </div>
    <div class="section-rule mb-10"></div>

    <div class="skills-container grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12">
      <div class="skills-column gsap-reveal rounded-xl bg-surface p-6 ring-1 ring-hairline lg:p-7">
        <h3 class="mb-6 flex items-center gap-3 font-display text-[1.05rem] font-bold tracking-tight text-ink">
          <span class="h-6 w-0.5 rounded-full bg-accent"></span>
          Habilidades Técnicas
          <span class="ml-auto font-mono text-[10px] tracking-widest uppercase text-ink-faint">Core</span>
        </h3>
        <div class="skills-list space-y-5">
          {skills.technical.map((skill) => (
            <div class="skill">
              <div class="skill-info flex justify-between items-center mb-1.5">
                <span class="font-mono text-sm text-ink-muted">{skill.name}</span>
                <span class="font-mono text-xs text-accent">{skill.percentage}%</span>
              </div>
              <div class="skill-bar h-1.5 w-full overflow-hidden rounded-full bg-surface-2" role="progressbar" aria-label={skill.name} aria-valuemin="0" aria-valuemax="100" aria-valuenow={skill.percentage}>
                <div
                  class="skill-progress h-full bg-ink rounded-full"
                  style={`width: ${skill.percentage}%;`}
                  data-percentage={skill.percentage}
                >
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="skills-column gsap-reveal rounded-xl bg-surface p-6 ring-1 ring-hairline lg:p-7">
        <h3 class="mb-6 flex items-center gap-3 font-display text-[1.05rem] font-bold tracking-tight text-ink">
          <span class="h-6 w-0.5 rounded-full bg-ink-muted"></span>
          Habilidades Personales
          <span class="ml-auto font-mono text-[10px] tracking-widest uppercase text-ink-faint">Human</span>
        </h3>
        <div class="skills-list space-y-5">
          {skills.personal.map((skill) => (
            <div class="skill">
              <div class="skill-info flex justify-between items-center mb-1.5">
                <span class="font-mono text-sm text-ink-muted">{skill.name}</span>
                <span class="font-mono text-xs text-ink-muted/70">{skill.percentage}%</span>
              </div>
              <div class="skill-bar h-1.5 w-full overflow-hidden rounded-full bg-surface-2" role="progressbar" aria-label={skill.name} aria-valuemin="0" aria-valuemax="100" aria-valuenow={skill.percentage}>
                <div
                  class="skill-progress h-full bg-ink-muted/70 rounded-full"
                  style={`width: ${skill.percentage}%;`}
                  data-percentage={skill.percentage}
                >
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="tools-container mt-14 gsap-reveal rounded-xl bg-surface p-6 ring-1 ring-hairline lg:p-7">
      <h3 class="mb-2 font-display text-center text-[1.05rem] font-bold tracking-tight text-ink">
        Herramientas y Tecnologías
      </h3>
      <p class="mb-6 text-center font-mono text-xs text-ink-faint">Stack probado en producción</p>
      <div class="tools-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5 max-w-4xl mx-auto">
        {skills.tools.map((tool) => (
          <div class="tool-item rounded-lg border border-hairline bg-canvas px-3 py-2.5 text-center font-mono text-[13px] text-ink-muted
                      transition-all duration-200
                      hover:border-accent hover:text-accent hover:bg-surface">
            {tool}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skill-bar { position: relative; }
  .skill-progress { will-change: width; }
</style>
