---
import skills from '../data/skills.json';
---

<section id="habilidades" class="skills bg-canvas py-24">
  <div class="container mx-auto px-6">
    <div class="scroll-reveal">
      <h2 class="section-title mb-16 font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-4xl">
        <span class="section-title-underline">Habilidades</span>
      </h2>
    </div>

    <div class="skills-container grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="skills-column scroll-reveal">
        <h3 class="mb-8 font-display text-lg font-bold tracking-tight text-ink border-l-2 border-accent pl-4">
          Habilidades Técnicas
        </h3>
        <div class="skills-list space-y-5">
          {skills.technical.map((skill) => (
            <div class="skill">
              <div class="skill-info flex justify-between items-center mb-1.5">
                <span class="font-mono text-sm text-ink-muted">{skill.name}</span>
                <span class="font-mono text-xs text-accent">{skill.percentage}%</span>
              </div>
              <div class="skill-bar h-1.5 w-full overflow-hidden rounded-full bg-surface-2" role="progressbar" aria-label={skill.name} aria-valuemin="0" aria-valuemax="100" aria-valuenow={skill.percentage}>
                <div
                  class="skill-progress h-full bg-ink rounded-full"
                  style={`width: ${skill.percentage}%;`}
                  data-percentage={skill.percentage}
                >
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="skills-column scroll-reveal">
        <h3 class="mb-8 font-display text-lg font-bold tracking-tight text-ink border-l-2 border-ink-muted pl-4">
          Habilidades Personales
        </h3>
        <div class="skills-list space-y-5">
          {skills.personal.map((skill) => (
            <div class="skill">
              <div class="skill-info flex justify-between items-center mb-1.5">
                <span class="font-mono text-sm text-ink-muted">{skill.name}</span>
                <span class="font-mono text-xs text-ink-muted/70">{skill.percentage}%</span>
              </div>
              <div class="skill-bar h-1.5 w-full overflow-hidden rounded-full bg-surface-2" role="progressbar" aria-label={skill.name} aria-valuemin="0" aria-valuemax="100" aria-valuenow={skill.percentage}>
                <div
                  class="skill-progress h-full bg-ink-muted/70 rounded-full"
                  style={`width: ${skill.percentage}%;`}
                  data-percentage={skill.percentage}
                >
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="tools-container mt-16 scroll-reveal">
      <h3 class="mb-8 font-display text-lg font-bold tracking-tight text-ink text-center">
        Herramientas y Tecnologías
      </h3>
      <div class="tools-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 max-w-4xl mx-auto">
        {skills.tools.map((tool) => (
          <div class="tool-item rounded-lg border border-hairline bg-surface px-3 py-2 text-center font-mono text-sm text-ink-muted
                      transition-all duration-200
                      hover:border-accent hover:text-accent">
            {tool}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skill-bar {
    position: relative;
  }

  .skill-progress {
    transition: width 1.5s ease-in-out;
  }
</style>

<script>
  {
    const skillBars = document.querySelectorAll<HTMLElement>('.skill-progress');

    skillBars.forEach(bar => {
      bar.style.width = '0%';
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const percentage = entry.target.getAttribute('data-percentage');
          setTimeout(() => {
            (entry.target as HTMLElement).style.width = `${percentage}%`;
          }, 200);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    skillBars.forEach(bar => {
      observer.observe(bar);
    });
  }
</script>