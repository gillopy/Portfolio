---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, shortDescription, tags, links, cover } = entry.data;
---

<article class="project-card flex h-full flex-col overflow-hidden rounded-xl border border-hairline bg-surface transition-all duration-300 hover:-translate-y-1 hover:ring-1 hover:ring-hairline">
  <a href={links.demo} class="project-image block overflow-hidden" aria-label={title}>
    <div class="aspect-video overflow-hidden">
      <Image
        src={cover}
        alt={title}
        class="w-full h-full object-cover object-center transition-transform duration-500 hover:scale-105"
        width={640}
        height={360}
      />
    </div>
  </a>

  <div class="project-details p-6 flex flex-col flex-grow">
    <h3 class="mb-2 font-display text-lg font-bold tracking-tight text-ink transition-colors duration-300 hover:text-accent">
      {title}
    </h3>
    <p class="mb-4 line-clamp-3 flex-grow text-sm leading-relaxed text-ink-muted">
      {shortDescription}
    </p>

    <div class="project-technologies flex flex-wrap gap-1.5 mb-5">
      {tags.slice(0, 5).map((tag) => (
        <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-muted ring-1 ring-hairline transition-colors duration-200 hover:text-accent">
          {tag}
        </span>
      ))}
      {tags.length > 5 && (
        <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-muted ring-1 ring-hairline">
          +{tags.length - 5}
        </span>
      )}
    </div>

    <div class="project-links flex gap-3 mt-auto">
      <a
        href={links.demo}
        class="btn-primary flex-1 justify-center !py-2 !px-4 text-sm"
      >
        Ver Proyecto
      </a>
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary flex-1 justify-center !py-2 !px-4 text-sm"
      >
        GitHub
      </a>
    </div>
  </div>
</article>