---
interface Project {
  id: string;
  title: string;
  shortDescription: string;
  image: string;
  tags: string[];
  links: {
    demo: string;
    github: string;
  };
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
import { Image } from 'astro:assets';
---

<article class="project-card flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-primary/30 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
  <div class="project-image m-3 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
    <div class="aspect-video overflow-hidden rounded-lg">
      <Image
        src={project.image}
        alt={project.title}
        class="w-full h-full object-cover object-center transition-transform duration-500 hover:scale-105"
        width={640}  
        height={360} 
      />
    </div>
  </div>

  <div class="project-details p-6 flex flex-col flex-grow">
    <h3 class="mb-2 text-xl font-bold text-slate-900 transition-colors duration-300 hover:text-primary dark:text-white">
      {project.title}
    </h3>
    <p class="mb-4 line-clamp-3 flex-grow text-slate-600 dark:text-slate-200">
      {project.shortDescription}
    </p>

    <div class="project-technologies flex flex-wrap gap-2 mb-5">
      {project.tags.slice(0, 5).map((tag) => (
        <span class="technology rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700 transition-all duration-300 hover:bg-primary hover:text-white dark:bg-slate-800 dark:text-slate-300">
          {tag}
        </span>
      ))}
      {project.tags.length > 5 && (
        <span class="technology rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700 transition-all duration-300 hover:bg-primary hover:text-white dark:bg-slate-800 dark:text-slate-300">
          +{project.tags.length - 5}
        </span>
      )}
    </div>

    <div class="project-links flex gap-3 mt-auto">
      <a
        href={project.links.demo}
        class="btn btn-primary bg-primary text-white text-sm py-2 px-4 rounded-md transition-all duration-300 flex-1 text-center hover:bg-secondary hover:shadow-md hover:-translate-y-1 active:translate-y-0"
      >
        Ver Proyecto
      </a>
      <a
        href={project.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline border border-primary text-primary hover:bg-primary hover:text-white text-sm py-2 px-4 rounded-md transition-all duration-300 flex-1 text-center hover:shadow-md hover:-translate-y-1 active:translate-y-0"
      >
        GitHub
      </a>
    </div>
  </div>
</article>
