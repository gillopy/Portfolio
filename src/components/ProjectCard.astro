---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SpotlightCard from './SpotlightCard.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, shortDescription, tags, links, cover } = entry.data;
---

<SpotlightCard
  as="article"
  class="project-card flex h-full flex-col rounded-2xl bg-surface"
>
  <div class="project-image aspect-[16/10] overflow-hidden rounded-t-2xl">
    <Image
      src={cover}
      alt={`Portada de ${title}`}
      class="h-full w-full object-cover object-center"
      width={640}
      height={400}
    />
  </div>

  <div class="project-details flex flex-1 flex-col px-6 pb-6 pt-5">
    <h3 class="max-w-[20ch] text-balance font-display text-xl font-bold leading-[1.15] tracking-[-0.025em] text-ink">
      <a
        href={links.demo}
        class="rounded-sm decoration-accent/60 decoration-1 underline-offset-4 transition-colors hover:text-accent hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
      >
        {title}
      </a>
    </h3>
    <p class="mt-3 line-clamp-3 flex-1 text-sm leading-6 text-ink-muted">
      {shortDescription}
    </p>

    <ul class="project-technologies mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[11px] leading-5 text-ink-faint" aria-label="Tecnologías utilizadas">
      {tags.slice(0, 3).map((tag, index) => (
        <li class="inline-flex items-center gap-2">
          {index > 0 && <span class="text-hairline" aria-hidden="true">·</span>}
          <span class="rounded-sm transition-colors duration-200 hover:text-accent">
            {tag}
          </span>
        </li>
      ))}
      {tags.length > 3 && (
        <li class="inline-flex items-center gap-2">
          <span class="text-hairline" aria-hidden="true">·</span>
          <span class="text-accent">+{tags.length - 3}</span>
        </li>
      )}
    </ul>

    <div class="project-links mt-5 flex justify-end">
      <a
        href={links.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Código de ${title} en GitHub`}
        class="inline-flex items-center gap-2 rounded-sm text-xs font-medium text-ink-muted transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.94 10.94 0 0 1 12 6.12c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.27c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
        </svg>
        GitHub
      </a>
    </div>
  </div>
</SpotlightCard>
