---
import profile from '../data/profile.json';
import siteConfig from '../data/siteConfig.json';

const year = new Date().getFullYear();
---

<footer class="relative border-t border-hairline-soft bg-canvas py-10">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-hairline to-transparent"></div>
  <div class="container mx-auto px-6">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <a href="/" class="group flex min-h-11 min-w-11 items-center justify-center gap-3 font-display text-xl font-bold tracking-tight text-ink transition-colors duration-300 hover:text-accent">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface ring-1 ring-hairline font-mono text-xs tracking-widest">{siteConfig.logoText}</span>
        <span class="hidden sm:block font-mono text-[10px] leading-none tracking-[0.14em] text-ink-faint uppercase">Observatory<br/>2026</span>
      </a>

      <p class="font-mono text-xs text-ink-faint">
        © {year} {profile.name}
      </p>
    </div>
  </div>
</footer>
