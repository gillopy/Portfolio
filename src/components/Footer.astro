---
import profile from '../data/profile.json';
import siteConfig from '../data/siteConfig.json';

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline-soft bg-canvas py-12">
  <div class="container mx-auto px-6">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
      <a href="/" class="font-display text-xl font-bold tracking-tight text-ink transition-colors duration-300 hover:text-accent">
        {siteConfig.logoText}
      </a>

      <ul class="flex flex-col items-center gap-3 text-center sm:flex-row sm:gap-6">
        {profile.social.map((social) => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-sm text-ink-muted transition-colors duration-300 hover:text-accent"
            >
              {social.platform}
            </a>
          </li>
        ))}
      </ul>

      <p class="font-mono text-xs text-ink-muted/60">
        © {year} {profile.name}
      </p>
    </div>
  </div>
</footer>