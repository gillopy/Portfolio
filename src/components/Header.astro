---
import siteConfig from '../data/siteConfig.json';
---

<header class="site-header header sticky top-0 z-50 w-full border-b border-hairline-soft bg-canvas/60 backdrop-blur-xl">
  <div class="container mx-auto px-6">
    <div class="header-content flex items-center justify-between py-3.5 transition-all duration-300">
      <div class="logo flex items-center gap-3">
        <a href="/" class="no-underline group flex items-center gap-3" aria-label="Ir al inicio">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface ring-1 ring-hairline font-mono text-xs font-bold tracking-widest text-ink group-hover:ring-accent transition-colors">{siteConfig.logoText}</span>
          <span class="hidden sm:block h-4 w-px bg-hairline"></span>
          <span class="hidden sm:block font-mono text-[10px] leading-none tracking-[0.14em] text-ink-faint uppercase">
            Data<br/>Observatory
          </span>
        </a>
      </div>
      <nav class="nav hidden md:block" aria-label="Navegación principal">
        <ul class="nav-list flex items-center gap-7">
          {siteConfig.navItems.map((item) => (
            <li class="nav-item">
              <a href={item.url} class:list={['nav-link relative group py-1 font-mono text-xs tracking-widest uppercase transition-colors duration-300', Astro.url.pathname + Astro.url.hash === item.url ? 'text-ink' : 'text-ink-muted hover:text-ink']} aria-current={Astro.url.pathname + Astro.url.hash === item.url ? 'page' : undefined}>
                {item.text}
                <span class={Astro.url.pathname + Astro.url.hash === item.url ? 'absolute -bottom-1 left-0 h-px w-full bg-accent' : 'absolute -bottom-1 left-0 h-px w-0 bg-accent group-hover:w-full transition-all duration-300'}></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <span class="hidden lg:flex items-center gap-2 rounded-pill bg-surface px-3 py-1.5 ring-1 ring-hairline">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]"></span>
          <span class="font-mono text-[11px] tracking-widest uppercase text-ink-muted">Disponible</span>
        </span>
        <a href="#contacto" class="btn-primary hidden md:inline-flex">
          Contáctame
        </a>
        <button type="button" class="mobile-toggle flex h-9 w-9 flex-col items-center justify-center gap-1.5 rounded-lg p-2 hover:bg-surface md:hidden" id="mobile-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
          <span class="block w-full h-px bg-ink rounded-full transition-all duration-300"></span>
          <span class="block w-full h-px bg-ink rounded-full transition-all duration-300"></span>
          <span class="block w-full h-px bg-ink rounded-full transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-menu overflow-hidden">
    <ul id="mobile-nav" class="nav-list absolute left-0 top-full hidden w-full flex-col space-y-1 border-b border-hairline bg-canvas px-6 py-4 shadow-xl md:hidden">
      {siteConfig.navItems.map((item) => (
        <li class="nav-item">
          <a href={item.url} class="nav-link block rounded-lg py-2.5 font-mono text-sm text-ink-muted transition-colors duration-300 hover:bg-surface hover:text-ink">
            {item.text}
          </a>
        </li>
      ))}
      <li class="nav-item">
        <a href="#contacto" class="nav-link block rounded-lg py-2.5 font-mono text-sm text-accent transition-colors duration-300 hover:bg-surface">
          Contáctame
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  .nav-list.open { display: flex; }
  .mobile-toggle.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .mobile-toggle.open span:nth-child(2) { opacity: 0; }
  .mobile-toggle.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .site-header.is-scrolled { border-color: #262626; box-shadow: 0 8px 32px rgba(0,0,0,0.4); }
  .site-header.is-scrolled .header-content { padding-top: 0.6rem; padding-bottom: 0.6rem; }
</style>

<script>
  const initHeader = () => {
    // Evita listeners duplicados con ClientRouter (navegación SPA)
    (window as unknown as { __headerCleanup?: () => void }).__headerCleanup?.();
    const mobileToggle = document.getElementById('mobile-toggle');
    const navList = document.getElementById('mobile-nav');
    if (!mobileToggle || !navList) return;
    let openScrollY = 0;
    let ticking = false;
    let gen = 0;
    const isOpen = () => mobileToggle.classList.contains('open');

    // Limpia TODOS los estilos en línea para que la clase `hidden` vuelva a ocultar el menú
    const resetInline = () => {
      navList.style.display = '';
      navList.style.height = '';
      navList.style.opacity = '';
      navList.style.overflow = '';
    };

    const closeMenu = (animated = false) => {
      gen++;
      const myGen = gen;
      navList.getAnimations().forEach((a) => a.cancel());
      mobileToggle.classList.remove('open');
      navList.classList.remove('open');
      mobileToggle.setAttribute('aria-expanded', 'false');
      mobileToggle.setAttribute('aria-label', 'Abrir menú');
      if (!animated) {
        resetInline();
        return;
      }
      const h = navList.scrollHeight;
      if (h === 0) {
        resetInline();
        return;
      }
      navList.style.display = 'flex';
      navList.style.overflow = 'hidden';
      navList.style.height = h + 'px';
      const anim = navList.animate(
        [{ height: h + 'px', opacity: 1 }, { height: '0px', opacity: 0 }],
        { duration: 220, easing: 'ease' },
      );
      anim.onfinish = () => { if (myGen === gen) resetInline(); };
      anim.oncancel = () => { if (myGen === gen) resetInline(); };
    };

    const toggleMenu = () => {
      if (isOpen()) {
        closeMenu(true);
        return;
      }
      gen++;
      const myGen = gen;
      navList.getAnimations().forEach((a) => a.cancel());
      openScrollY = window.scrollY;
      mobileToggle.classList.add('open');
      navList.classList.add('open');
      mobileToggle.setAttribute('aria-expanded', 'true');
      mobileToggle.setAttribute('aria-label', 'Cerrar menú');
      navList.style.display = 'flex';
      navList.style.overflow = 'hidden';
      const h = navList.scrollHeight;
      const anim = navList.animate(
        [{ height: '0px', opacity: 0 }, { height: h + 'px', opacity: 1 }],
        { duration: 260, easing: 'cubic-bezier(0.16,1,0.3,1)' },
      );
      anim.onfinish = () => {
        if (myGen !== gen || !isOpen()) return;
        navList.style.height = 'auto';
        navList.style.opacity = '1';
      };
    };

    // Cierre automático al scrollear: si se mueve +12px con el menú abierto, se cierra
    const onScroll = () => {
      if (!isOpen() || ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        if (isOpen() && Math.abs(window.scrollY - openScrollY) > 12) closeMenu();
        ticking = false;
      });
    };
    const onResize = () => {
      if (window.innerWidth >= 768) closeMenu();
    };
    const onDocClick = (e: MouseEvent) => {
      if (!isOpen()) return;
      const t = e.target;
      if (!(t instanceof Element)) return;
      if (t.closest('#mobile-toggle')) return;
      if (!t.closest('.site-header')) closeMenu(true);
    };
    const onKeydown = (e: KeyboardEvent) => { if (e.key === 'Escape') closeMenu(true); };
    const onLinkClick = () => closeMenu();

    mobileToggle.addEventListener('click', toggleMenu);
    navList.querySelectorAll('a').forEach((link) => link.addEventListener('click', onLinkClick));
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    document.addEventListener('click', onDocClick);
    document.addEventListener('keydown', onKeydown);

    (window as unknown as { __headerCleanup?: () => void }).__headerCleanup = () => {
      mobileToggle.removeEventListener('click', toggleMenu);
      navList.querySelectorAll('a').forEach((link) => link.removeEventListener('click', onLinkClick));
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      document.removeEventListener('click', onDocClick);
      document.removeEventListener('keydown', onKeydown);
    };
  };

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('astro:after-swap', initHeader);
</script>
