---
import profile from '../data/profile.json';
import DataPlanet from './DataPlanet.astro';

const firstName = profile.name.split(' ').slice(0, -1).join(' ');
const lastName = profile.name.split(' ').slice(-1)[0];
const firstChars = firstName.split('');
const lastChars = lastName.split('');

// Station readout, resolved at build time so it is correct before JS runs and
// then refreshed client-side. Paraguay is UTC-3 on DST and UTC-4 off it, so the
// offset is formatted rather than hardcoded. A constrained ICU build would make
// the formatter throw, hence the guarded fallback.
const STATION_TIME_ZONE = 'America/Asuncion';
const readStationTime = (): { time: string; zone: string } => {
  try {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: STATION_TIME_ZONE,
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
      timeZoneName: 'shortOffset',
    }).formatToParts(new Date());
    const pick = (type: string) => parts.find((part) => part.type === type)?.value ?? '';
    return { time: `${pick('hour')}:${pick('minute')}`, zone: pick('timeZoneName') };
  } catch {
    return { time: '--:--', zone: '' };
  }
};
const station = readStationTime();
---

<section id="inicio" class="hero relative flex min-h-[96vh] items-center overflow-hidden bg-canvas pb-20 pt-28">
  <!-- ambient glow -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-[-8%] h-[520px] w-[720px] -translate-x-1/2 rounded-full bg-accent/10 blur-[80px]"></div>
    <div class="absolute right-[-6%] top-[18%] h-[420px] w-[420px] rounded-full bg-accent-2/10 blur-[70px]"></div>
  </div>

  <div class="container mx-auto px-6">
    <div class="hero-content flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-16">
      <div class="hero-text w-full lg:w-[58%]">
        <!-- kicker -->
        <div class="hero-kicker mb-6 flex flex-wrap items-center gap-3">
          <span class="kicker"><span class="kicker-dot"></span> Observatorio de datos — Asunción, PY</span>
          <span class="hidden sm:inline-flex items-center gap-2 rounded-pill bg-surface px-3 py-1 ring-1 ring-hairline font-mono text-[11px] tracking-widest uppercase text-ink-muted">
            <span class="h-1 w-1 rounded-full bg-accent"></span>
            {profile.title}
          </span>
        </div>

        <h1 class="mb-5 font-display text-[2.95rem] font-bold leading-[0.9] tracking-[-0.04em] text-ink md:text-[4.5rem] lg:text-[5.2rem]">
          <span class="hero-word overflow-hidden inline-block">
            <span class="hero-line inline-flex">
              {firstChars.map((ch) => (
                <span class="hero-char">{ch === ' ' ? '\u00A0' : ch}</span>
              ))}
            </span>
          </span>
          <br />
          <span class="hero-word overflow-hidden inline-block">
            <span class="hero-line inline-flex text-accent">
              {lastChars.map((ch) => (
                <span class="hero-char">{ch}</span>
              ))}
            </span>
            <span class="ml-2 inline-block h-[0.18em] w-[0.18em] translate-y-[-0.35em] rounded-full bg-accent"></span>
          </span>
        </h1>

        <p class="hero-summary mb-8 max-w-[58ch] text-[1.06rem] leading-relaxed text-ink-muted md:text-[1.15rem]">
          {profile.summary}
          <span class="mt-3 block font-mono text-xs tracking-wide text-ink-faint">Econometría · Forecasting · MLOps · Series temporales</span>
        </p>

        <!-- Cadena de valor: los mismos tres pasos y subtítulos, restated as a
             technical strip. At display-bold 2.1rem they read as a second H1
             directly under the name, which is what this fixes. -->
        <div class="hero-pipeline">
          <ol class="hero-pipeline-list">
            <li class="hero-step">
              <span class="hero-step-index" aria-hidden="true">01</span>
              <span class="hero-step-text">
                <span class="hero-step-label">Análisis</span>
                <span class="hero-step-caption">De datos a evidencia.</span>
              </span>
            </li>
            <li class="hero-step">
              <span class="hero-step-index" aria-hidden="true">02</span>
              <span class="hero-step-text">
                <span class="hero-step-label">Modelado</span>
                <span class="hero-step-caption">De evidencia a predicción.</span>
              </span>
            </li>
            <li class="hero-step">
              <span class="hero-step-index" aria-hidden="true">03</span>
              <span class="hero-step-text">
                <span class="hero-step-label">Decisión</span>
                <span class="hero-step-caption">De predicción a estrategia.</span>
              </span>
            </li>
            <li class="hero-readout">
              <span class="hero-readout-label">Local</span>
              <span class="hero-readout-value" id="hero-clock" aria-live="off">{station.time} {station.zone}</span>
            </li>
          </ol>
        </div>

        <div class="hero-btns flex flex-wrap items-center gap-3">
          <a href="#proyectos" class="btn-primary group">
            Ver Proyectos
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#contacto" class="btn-secondary">
            Contacto
          </a>
          <span class="hidden items-center gap-2 pl-2 font-mono text-xs text-ink-faint sm:inline-flex">
            <span class="h-px w-6 bg-hairline"></span>
            Respuesta &lt; 24h
          </span>
        </div>


      </div>

      <div class="hero-visual w-full lg:w-[42%] flex justify-center">
        <DataPlanet />
      </div>
    </div>
  </div>

  <div class="scroll-indicator absolute bottom-6 left-1/2 -translate-x-1/2 hidden flex-col items-center gap-2 md:flex">
    <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-faint">Scroll</span>
    <div class="h-8 w-px bg-gradient-to-b from-ink-faint/50 to-transparent"></div>
  </div>
</section>

<style>
  /* Border-top/bottom give the strip its instrument-panel framing; the steps
     are then separated by a single rule that flips from horizontal (stacked) to
     vertical (three across) at the same breakpoint the desktop nav appears. */
  .hero-pipeline {
    margin-bottom: 2.5rem;
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }
  .hero-pipeline-list {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-step {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.8rem 0;
  }
  .hero-step + .hero-step {
    border-top: 1px solid var(--color-hairline-soft);
  }
  .hero-step-index {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: var(--color-accent);
  }
  .hero-step-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
  }
  .hero-step-label {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .hero-step-caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
  }
  /* Station readout: a fourth cell on wide screens, dropped below lg where the
     three steps already fill the strip. */
  .hero-readout {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 0 0.95rem 1.25rem;
    border-left: 1px solid var(--color-hairline-soft);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero-readout-label {
    color: var(--color-ink-faint);
  }
  .hero-readout-value {
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  @media (min-width: 1024px) {
    .hero-pipeline-list {
      grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    }
    .hero-step {
      padding: 0.95rem 1.25rem;
    }
    .hero-step:first-child {
      padding-left: 0;
    }
    .hero-step + .hero-step {
      border-top: 0;
      border-left: 1px solid var(--color-hairline-soft);
    }
    .hero-readout {
      display: flex;
    }
  }
</style>

<script>
  // Build-time value is correct without JS; this only keeps the minute honest
  // on a long-lived page. 20s cadence is enough for HH:MM and costs nothing.
  const STATION_TIME_ZONE = 'America/Asuncion';
  let stationTimer: number | undefined;

  const startStationClock = () => {
    window.clearInterval(stationTimer);
    const el = document.getElementById('hero-clock');
    if (!el) return;
    const format = () =>
      new Intl.DateTimeFormat('en-GB', {
        timeZone: STATION_TIME_ZONE,
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
        timeZoneName: 'shortOffset',
      }).format(new Date());
    const tick = () => {
      el.textContent = format();
    };
    tick();
    stationTimer = window.setInterval(tick, 20_000);
  };

  startStationClock();
  document.addEventListener('astro:page-load', startStationClock);
  document.addEventListener('astro:before-preparation', () => {
    window.clearInterval(stationTimer);
  });
</script>
