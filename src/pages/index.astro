---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ArticlesSection from '../components/ArticlesSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import profile from '../data/profile.json';
import siteConfig from '../data/siteConfig.json';

const pageTitle = `${profile.name} — ${profile.shortTitle}`;
const pageDescription = profile.shortDescription;
const siteUrl = siteConfig.siteUrl;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.title,
    url: siteUrl,
    image: `${siteUrl}${profile.profileImage}`,
    sameAs: profile.social.map((s: { url: string }) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.title,
    url: siteUrl,
    description: pageDescription,
    inLanguage: siteConfig.locale ?? 'es_PY',
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt="Imagen de apertura del portafolio de Guillermo Cabrera"
>
  <Header />

  <main id="main-content">
    <HeroSection />
    <AboutSection />
    <ProjectsSection />
    <ArticlesSection />
    <SkillsSection />
    <ContactSection />
  </main>
</Layout>
