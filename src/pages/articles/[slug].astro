---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
	const articles: CollectionEntry<'articles'>[] = await getCollection('articles');
	return articles.map((entry: CollectionEntry<'articles'>) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, shortDescription, tags, publishDate, cover, attribution } = entry.data;
// og:image must be a processed derivative served from /_astro (raw cover.src is
// not a fetchable static asset) AND exactly 1.91:1, or WhatsApp crops it again.
// Astro 7's sharp service hardcodes withoutEnlargement (and maps fit 'contain'
// to sharp 'inside', no padding), so a plain 1200x630 cover request from a
// smaller cover silently returns a wrong-ratio image. Instead, request the
// largest 1200:630 window the source can provide at 1:1 (exactly 1200x630 for
// large covers, native-detail 1.91:1 crops for smaller ones). JPEG for maximum
// social-crawler compatibility. Layout falls back to the site default when no
// derivative is produced.
const ogW0 = typeof cover === 'string' ? 1200 : Math.min(cover.width, 1200);
const ogH0 = typeof cover === 'string' ? 630 : Math.min(cover.height, 630);
let ogW = ogW0;
let ogH = Math.round((ogW0 * 630) / 1200);
if (ogH > ogH0) {
	ogH = ogH0;
	ogW = Math.round((ogH0 * 1200) / 630);
}
const ogImage = cover
	? (await getImage({ src: cover, width: ogW, height: ogH, fit: 'cover', format: 'jpeg' })).src
	: undefined;
const dateLabel = new Intl.DateTimeFormat('es', { day: 'numeric', month: 'long', year: 'numeric' }).format(publishDate);
---

<ArticleLayout title={title} description={shortDescription} image={ogImage} ogType="article" ogImageWidth={ogW} ogImageHeight={ogH} ogImageAlt={title}>
  <h1 class="mb-4 font-display text-3xl font-bold tracking-[-0.02em] text-ink md:text-5xl">{title}</h1>
  <p class="mb-8 whitespace-pre-line text-lg leading-relaxed text-ink-muted">{shortDescription}</p>

  <div class="mb-10">
    <p class="mb-4 font-mono text-xs tracking-widest uppercase text-ink-faint">
      Publicado el {dateLabel}
    </p>
    <div class="technologies mb-6">
      <h3 class="mb-3 font-display text-lg font-bold tracking-tight text-ink">Etiquetas</h3>
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag: string) => (
          <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-muted ring-1 ring-hairline transition-colors duration-200 hover:text-accent">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Attribution (top): text and URL come from the article's frontmatter. -->
  <aside class="mb-10 rounded-xl border border-hairline bg-surface p-4 font-mono text-xs leading-relaxed text-ink-muted">
    <p class="mb-1 tracking-widest uppercase text-ink-faint">Fuente original</p>
    <p class="mb-2">{attribution.text}</p>
    <a href={attribution.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover">
      Ver fuente ↗
    </a>
  </aside>

  <Content />

  <!-- Attribution (footer): same frontmatter source, repeated after the body. -->
  <aside class="mt-10 rounded-xl border border-hairline bg-surface p-4 font-mono text-xs leading-relaxed text-ink-muted">
    <p class="mb-1 tracking-widest uppercase text-ink-faint">Fuente original</p>
    <p class="mb-2">{attribution.text}</p>
    <a href={attribution.url} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover">
      Ver fuente ↗
    </a>
  </aside>
</ArticleLayout>
